page {
  background: linear-gradient(180deg, #e7eef4 0%, #f4f6f8 55%, #edf1f4 100%);
}

.profile-card,
.data-dashboard,
.section-tabs,
.news-list,
.comment-history,
.login-required {
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.profile-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  min-height: 286rpx;
  padding: 48rpx 32rpx 90rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #012d61 0%, #034d91 58%, #087ca7 100%);
  color: #ffffff;
}

.profile-card::before,
.profile-card::after {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 50%;
  content: "";
}

.profile-card::before {
  top: -210rpx;
  right: -100rpx;
  width: 480rpx;
  height: 480rpx;
}

.profile-card::after {
  right: -170rpx;
  bottom: -210rpx;
  width: 600rpx;
  height: 300rpx;
  transform: rotate(-12deg);
}

.avatar {
  position: relative;
  z-index: 2;
  display: flex;
  flex-shrink: 0;
  width: 130rpx;
  height: 130rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(239, 201, 120, 0.82);
  border-radius: 50%;
  background: #ffffff;
}

.avatar.placeholder {
  color: #034da2;
  font-size: 48rpx;
  font-weight: 700;
}

.avatar-shell {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  width: 138rpx;
  height: 138rpx;
}

.avatar-shell .avatar {
  position: absolute;
  top: 0;
  left: 0;
  box-sizing: border-box;
  width: 138rpx;
  height: 138rpx;
}

.avatar-edit-badge {
  position: absolute;
  z-index: 5;
  right: -2rpx;
  bottom: 0;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #07518a;
  border-radius: 50%;
  background: #efc978;
  color: #173e66;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  box-shadow: 0 5rpx 12rpx rgba(0, 21, 44, 0.28);
}

.profile-info {
  position: relative;
  z-index: 2;
  display: flex;
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
  flex-direction: column;
}

.profile-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.nickname {
  overflow: hidden;
  font-family: "STSong", "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-tip {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.avatar-upload-tip {
  margin-top: 8rpx;
  color: rgba(239, 201, 120, 0.9);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.login-button {
  display: flex;
  width: 100%;
  height: 92rpx;
  margin: 30rpx 0 0;
  padding: 0 30rpx;
  align-items: center;
  justify-content: space-between;
  border: 0;
  border-radius: 10rpx;
  background: #dfe5ea;
  color: #94a0aa;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 92rpx;
  letter-spacing: 2rpx;
  text-align: left;
}

.login-button::after {
  border: 0;
}

.login-button.ready {
  background: linear-gradient(105deg, #02366d 0%, #056b98 100%);
  box-shadow: 0 14rpx 30rpx rgba(3, 67, 117, 0.24);
  color: #ffffff;
}

.login-button[disabled] {
  opacity: 1;
}

.login-arrow {
  font-family: Georgia, serif;
  font-size: 42rpx;
  font-weight: 400;
}

.logout-button {
  flex-shrink: 0;
  width: 142rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 7rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 56rpx;
}

.logout-button::after {
  border: 0;
}

.data-dashboard {
  position: relative;
  z-index: 4;
  display: flex;
  margin: -54rpx 22rpx 0;
  padding: 30rpx 10rpx;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(18, 52, 84, 0.16);
}

.data-item {
  display: flex;
  flex: 1;
  align-items: center;
  flex-direction: column;
}

.data-value {
  color: #173e66;
  font-family: Georgia, serif;
  font-size: 40rpx;
  font-weight: 700;
}

.data-label {
  margin-top: 6rpx;
  color: #7c8490;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.data-divider {
  width: 1rpx;
  height: 54rpx;
  background: #e7ebef;
}

.section-tabs {
  display: flex;
  align-items: center;
  margin: 24rpx 22rpx 0;
  padding: 0 12rpx;
  border: 1rpx solid rgba(20, 54, 86, 0.06);
  border-radius: 15rpx 15rpx 0 0;
  background: #ffffff;
}

.section-tab {
  position: relative;
  display: flex;
  flex: 1;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #7c8995;
  font-size: 23rpx;
}

.section-tab.active {
  color: #173e66;
  font-weight: 600;
}

.section-tab.active::after {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 74rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #c09342;
  content: '';
  transform: translateX(-50%);
}

.section-count {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background: #edf2f6;
  color: #577088;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 30rpx;
  text-align: center;
}

.comment-history {
  margin: 1rpx 22rpx 0;
  overflow: hidden;
  border-radius: 0 0 15rpx 15rpx;
  background: #ffffff;
}

.comment-history-item {
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #edf0f3;
}

.comment-history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.comment-article-title {
  overflow: hidden;
  flex: 1;
  color: #24557f;
  font-size: 24rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comment-history-time {
  flex-shrink: 0;
  color: #a0a7b0;
  font-size: 21rpx;
}

.comment-history-content {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 14rpx;
  color: #3f4854;
  font-size: 28rpx;
  line-height: 1.65;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.login-required {
  position: relative;
  overflow: hidden;
  display: flex;
  margin: -46rpx 22rpx 24rpx;
  padding: 72rpx 34rpx 38rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 18rpx;
  background:
    linear-gradient(135deg, rgba(234, 244, 249, 0.65), transparent 42%),
    #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(18, 52, 84, 0.14);
  flex-direction: column;
}

.login-required::before {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, #c59743, #0b87a8, #034d91);
  content: '';
}

.login-badge {
  align-self: flex-start;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(3, 77, 145, 0.18);
  border-radius: 4rpx;
  background: #edf5f9;
  color: #176589;
  font-family: Georgia, serif;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.login-required-title {
  margin-top: 22rpx;
  color: #163b5e;
  font-family: "STSong", "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 600;
}

.login-required-tip {
  margin-top: 16rpx;
  color: #687887;
  font-size: 24rpx;
  line-height: 1.75;
}

.permission-flow {
  display: flex;
  margin: 34rpx 0 28rpx;
  align-items: flex-start;
  justify-content: center;
}

.permission-flow.single-flow {
  margin: 30rpx 0 26rpx;
}

.single-flow .flow-item {
  width: auto;
  min-width: 260rpx;
  padding: 16rpx 34rpx;
  border: 1rpx solid rgba(3, 77, 145, 0.13);
  border-radius: 48rpx;
  background: linear-gradient(90deg, #f4f8fb, #edf6f8);
  flex-direction: row;
  justify-content: center;
}

.single-flow .flow-number {
  flex-shrink: 0;
}

.single-flow .flow-label {
  margin: 0 0 0 14rpx;
  color: #315978;
  font-size: 23rpx;
  font-weight: 600;
}

.flow-item {
  display: flex;
  width: 118rpx;
  align-items: center;
  flex-direction: column;
}

.flow-number {
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid rgba(3, 77, 145, 0.26);
  border-radius: 50%;
  background: #f3f8fb;
  color: #034d91;
  font-family: Georgia, serif;
  font-size: 24rpx;
  line-height: 48rpx;
  text-align: center;
}

.flow-label {
  margin-top: 10rpx;
  color: #657786;
  font-size: 20rpx;
}

.flow-line {
  width: 74rpx;
  height: 1rpx;
  margin-top: 24rpx;
  background: linear-gradient(90deg, #cfd9e1, #8bb4c8, #cfd9e1);
}

.data-scope {
  overflow: hidden;
  border: 1rpx solid #e4ebf0;
  border-radius: 10rpx;
  background: rgba(247, 250, 252, 0.84);
}

.scope-row {
  display: flex;
  min-height: 72rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #e8edf1;
}

.scope-row:last-child {
  border-bottom: 0;
}

.scope-name {
  color: #81909c;
  font-size: 22rpx;
}

.scope-value {
  color: #344f68;
  font-size: 23rpx;
  font-weight: 600;
}

.scope-value.safe {
  color: #16735b;
}

.scope-value.safe::before {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #26a37a;
  content: '';
}

.consent-check {
  margin-top: 26rpx;
}

.consent-label {
  display: flex;
  align-items: center;
  color: #425a70;
  font-size: 23rpx;
}

.consent-label checkbox {
  margin-right: 10rpx;
  transform: scale(0.82);
}

.policy-links {
  display: flex;
  margin: 12rpx 0 0 54rpx;
  align-items: center;
  color: #035a9a;
  font-size: 22rpx;
}

.link-and {
  margin: 0 4rpx;
  color: #8b969f;
}

.login-footnote {
  margin-top: 22rpx;
  color: #9aa4ad;
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}

.demo-login {
  display: flex;
  min-height: 62rpx;
  margin-top: 18rpx;
  padding: 0 18rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(13, 116, 148, 0.3);
  border-radius: 8rpx;
  background: rgba(235, 247, 249, 0.7);
  color: #26728b;
  font-size: 21rpx;
}

.demo-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #22a27b;
  box-shadow: 0 0 0 6rpx rgba(34, 162, 123, 0.1);
}

.privacy-console {
  margin: 24rpx 22rpx 0;
  padding: 30rpx 26rpx 20rpx;
  border: 1rpx solid rgba(22, 61, 94, 0.08);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(20, 50, 78, 0.07);
}

.console-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.console-eyebrow,
.console-title {
  display: block;
}

.console-eyebrow {
  color: #a47b37;
  font-family: Georgia, serif;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.console-title {
  margin-top: 8rpx;
  color: #173e66;
  font-family: "STSong", "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 600;
}

.security-status {
  display: flex;
  padding: 8rpx 12rpx;
  align-items: center;
  border-radius: 20rpx;
  background: #edf8f3;
  color: #23775d;
  font-size: 19rpx;
}

.status-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #27a276;
  box-shadow: 0 0 0 6rpx rgba(39, 162, 118, 0.1);
}

.console-grid {
  margin-top: 24rpx;
  border-top: 1rpx solid #e9edf1;
}

.console-action {
  display: flex;
  min-height: 86rpx;
  align-items: center;
  border-bottom: 1rpx solid #edf0f3;
}

.action-index {
  width: 56rpx;
  color: #a47b37;
  font-family: Georgia, serif;
  font-size: 20rpx;
}

.action-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.action-title {
  color: #2d475f;
  font-size: 24rpx;
  font-weight: 600;
}

.action-desc {
  margin-top: 5rpx;
  color: #9aa3ab;
  font-size: 19rpx;
}

.action-arrow {
  color: #9aa8b3;
  font-family: Georgia, serif;
  font-size: 35rpx;
}

.console-action.danger .action-title {
  color: #9c453d;
}

.consent-version {
  display: block;
  margin-top: 18rpx;
  color: #a2aab1;
  font-size: 18rpx;
  text-align: center;
}

.policy-mask {
  position: fixed;
  z-index: 99;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(5, 21, 36, 0.68);
  backdrop-filter: blur(8rpx);
}

.policy-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 18rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 28rpx 28rpx 0 0;
  background:
    radial-gradient(circle at 95% 0, rgba(12, 137, 169, 0.1), transparent 26%),
    #ffffff;
  animation: sheet-rise 260ms ease-out both;
}

@keyframes sheet-rise {
  from {
    opacity: 0;
    transform: translateY(80rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.sheet-handle {
  width: 76rpx;
  height: 7rpx;
  margin: 0 auto 30rpx;
  border-radius: 4rpx;
  background: #dce2e7;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-eyebrow,
.sheet-title {
  display: block;
}

.sheet-eyebrow {
  color: #a47b37;
  font-family: Georgia, serif;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.sheet-title {
  margin-top: 10rpx;
  color: #163b5e;
  font-family: "STSong", "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 600;
}

.sheet-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #edf2f5;
  color: #667786;
  font-family: Georgia, serif;
  font-size: 38rpx;
  line-height: 54rpx;
  text-align: center;
}

.policy-highlight {
  margin: 28rpx 0 8rpx;
  padding: 22rpx 24rpx;
  border-left: 6rpx solid #c49848;
  background: #f7f4ed;
  color: #5e594d;
  font-size: 23rpx;
  line-height: 1.7;
}

.policy-section {
  display: flex;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #e9edf0;
}

.policy-number {
  flex-shrink: 0;
  width: 72rpx;
  color: #0a789c;
  font-family: Georgia, serif;
  font-size: 22rpx;
  font-weight: 700;
}

.policy-title,
.policy-text {
  display: block;
}

.policy-title {
  color: #27445e;
  font-size: 26rpx;
  font-weight: 600;
}

.policy-text {
  margin-top: 10rpx;
  color: #6e7c88;
  font-size: 23rpx;
  line-height: 1.75;
}

.sheet-confirm {
  height: 82rpx;
  margin: 28rpx 0 0;
  border-radius: 8rpx;
  background: #034d91;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 82rpx;
}

.sheet-confirm::after {
  border: 0;
}

.news-list {
  margin: 1rpx 22rpx 0;
  overflow: hidden;
  border-radius: 0 0 15rpx 15rpx;
  box-shadow: 0 12rpx 30rpx rgba(20, 50, 78, 0.06);
}

.list-item {
  padding: 22rpx;
  background: #ffffff;
}

.list-item-image {
  border-radius: 10rpx;
}

.empty-state {
  margin: 1rpx 22rpx 0;
  border-radius: 0 0 15rpx 15rpx;
  background: #ffffff;
}
