page {
  background: #edf2f6;
  color: #132238;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.masthead {
  position: relative;
  overflow: hidden;
  padding: 38rpx 24rpx 86rpx;
  background: linear-gradient(145deg, #012d61 0%, #034d91 52%, #087da8 100%);
  color: #ffffff;
}

.masthead::after {
  position: absolute;
  right: -100rpx;
  bottom: -170rpx;
  width: 620rpx;
  height: 300rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  content: "";
  transform: rotate(-10deg);
}

.orb {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
}

.orb-one {
  top: -180rpx;
  right: -80rpx;
  width: 420rpx;
  height: 420rpx;
}

.orb-two {
  top: -95rpx;
  right: 5rpx;
  width: 250rpx;
  height: 250rpx;
  background: rgba(255, 255, 255, 0.03);
}

.brand-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  animation: masthead-reveal 650ms ease-out both;
}

.brand-mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  font-family: Georgia, serif;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.brand-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  flex-direction: column;
}

.brand-name {
  font-family: "STSong", "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.brand-en {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.edition {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
}

.edition-number {
  font-family: Georgia, serif;
  font-size: 36rpx;
  line-height: 1;
}

.edition-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 18rpx;
}

.masthead-line {
  position: relative;
  z-index: 2;
  display: flex;
  margin: 30rpx 0 24rpx;
  padding-top: 18rpx;
  justify-content: space-between;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.66);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.news-swiper {
  position: relative;
  z-index: 3;
  width: 100%;
  height: 440rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #0a2747;
  box-shadow: 0 30rpx 70rpx rgba(0, 18, 43, 0.34);
  animation: cover-reveal 780ms 100ms ease-out both;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.swiper-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(90deg, rgba(0, 21, 48, 0.88) 0%, rgba(0, 25, 58, 0.24) 72%), linear-gradient(transparent 35%, rgba(0, 15, 37, 0.86));
}

.swiper-copy {
  position: absolute;
  right: 34rpx;
  bottom: 34rpx;
  left: 34rpx;
  display: flex;
  flex-direction: column;
}

.focus-row {
  display: flex;
  align-items: center;
}

.swiper-label {
  color: #f0c675;
  font-family: Georgia, serif;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.focus-line {
  width: 42rpx;
  height: 1rpx;
  margin: 0 12rpx;
  background: rgba(240, 198, 117, 0.75);
}

.focus-tip {
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
}

.swiper-title {
  display: -webkit-box;
  overflow: hidden;
  max-width: 620rpx;
  margin-top: 16rpx;
  font-family: "STSong", "Songti SC", serif;
  font-size: 39rpx;
  font-weight: 700;
  line-height: 1.38;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.read-more {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.content-shell {
  position: relative;
  z-index: 4;
  margin-top: -48rpx;
  padding: 0 20rpx 50rpx;
}

.search-panel {
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(17, 51, 84, 0.13);
}

.search-box {
  display: flex;
  height: 76rpx;
  padding: 0 22rpx;
  align-items: center;
  border-radius: 14rpx;
  background: #f0f4f7;
}

.search-symbol {
  position: relative;
  width: 25rpx;
  height: 25rpx;
  margin-right: 20rpx;
  border: 3rpx solid #42627f;
  border-radius: 50%;
}

.search-symbol::after {
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 12rpx;
  height: 3rpx;
  background: #42627f;
  content: "";
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  height: 76rpx;
  color: #15283d;
  font-size: 27rpx;
}

.search-placeholder {
  color: #8b9baa;
}

.clear-search {
  color: #58718a;
  font-size: 23rpx;
}

.keyword-rail {
  display: flex;
  margin-top: 16rpx;
  align-items: center;
}

.keyword-label {
  flex-shrink: 0;
  margin: 0 18rpx 0 4rpx;
  color: #a27a36;
  font-family: Georgia, serif;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.keyword-scroll {
  display: flex;
  width: calc(100% - 72rpx);
  white-space: nowrap;
}

.keyword-item {
  display: inline-block;
  margin-right: 12rpx;
  padding: 9rpx 16rpx;
  border: 1rpx solid #dfe8ee;
  border-radius: 22rpx;
  background: #f7fafb;
  color: #4d687e;
  font-size: 20rpx;
  line-height: 1.2;
}

.keyword-item:last-child {
  margin-right: 0;
}

.category-scroll {
  display: flex;
  width: 100%;
  padding: 26rpx 4rpx 12rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.category-chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 13rpx 28rpx;
  border: 1rpx solid #cbd6df;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #5a6c7c;
  font-size: 24rpx;
}

.category-chip.active {
  border-color: #034d91;
  background: #034d91;
  box-shadow: 0 8rpx 20rpx rgba(3, 77, 145, 0.2);
  color: #ffffff;
}

.section-heading {
  display: flex;
  margin: 28rpx 4rpx 22rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.heading-title {
  display: flex;
  flex-direction: column;
}

.heading-en {
  color: #b28432;
  font-family: Georgia, serif;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.heading-cn {
  margin-top: 4rpx;
  color: #132238;
  font-family: "STSong", "Songti SC", serif;
  font-size: 39rpx;
  font-weight: 700;
}

.heading-actions,
.sort-switch {
  display: flex;
  align-items: center;
}

.heading-actions {
  gap: 14rpx;
}

.news-count {
  color: #8795a2;
  font-size: 22rpx;
}

.sort-switch {
  padding: 4rpx;
  border: 1rpx solid #d5dde4;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
}

.sort-option {
  padding: 8rpx 16rpx;
  border-radius: 5rpx;
  color: #7b8996;
  font-size: 21rpx;
}

.sort-option.active {
  background: #173c63;
  color: #ffffff;
}

.feature-card,
.story-card {
  overflow: hidden;
  border: 1rpx solid rgba(21, 57, 91, 0.08);
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(20, 49, 76, 0.08);
}

.feature-card {
  border-radius: 22rpx;
}

.feature-image-wrap {
  position: relative;
  height: 350rpx;
  overflow: hidden;
}

.feature-image {
  width: 100%;
  height: 100%;
}

.feature-category {
  position: absolute;
  bottom: 20rpx;
  left: 22rpx;
  padding: 9rpx 18rpx;
  border-radius: 5rpx;
  background: rgba(2, 56, 109, 0.92);
  color: #ffffff;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.feature-content {
  padding: 28rpx 28rpx 26rpx;
}

.feature-kicker {
  color: #b28432;
  font-family: Georgia, serif;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.feature-title {
  display: block;
  margin-top: 12rpx;
  color: #14263a;
  font-family: "STSong", "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
}

.feature-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 14rpx;
  color: #667584;
  font-size: 25rpx;
  line-height: 1.65;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.feature-meta {
  display: flex;
  margin-top: 22rpx;
  padding-top: 18rpx;
  align-items: center;
  border-top: 1rpx solid #edf0f2;
  color: #8a96a2;
  font-size: 22rpx;
}

.meta-dot {
  width: 5rpx;
  height: 5rpx;
  margin: 0 12rpx;
  border-radius: 50%;
  background: #c4ccd3;
}

.feature-arrow {
  margin-left: auto;
  color: #034d91;
  font-size: 30rpx;
}

.story-card {
  display: flex;
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 18rpx;
}

.story-image {
  flex-shrink: 0;
  width: 236rpx;
  height: 174rpx;
  border-radius: 12rpx;
  background: #d9e1e7;
}

.story-content {
  display: flex;
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  flex-direction: column;
}

.story-topline,
.story-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.story-category {
  color: #b28432;
  font-size: 20rpx;
  font-weight: 600;
}

.story-index {
  color: #d8dee4;
  font-family: Georgia, serif;
  font-size: 26rpx;
  font-weight: 700;
}

.story-title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  color: #1d3045;
  font-family: "STSong", "Songti SC", serif;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.46;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.story-meta {
  margin-top: auto;
  color: #929eaa;
  font-size: 20rpx;
}

.reveal-card {
  animation: card-reveal 520ms ease-out both;
}

.search-empty {
  display: flex;
  padding: 110rpx 20rpx;
  align-items: center;
  border-radius: 20rpx;
  background: #ffffff;
  flex-direction: column;
}

.empty-monogram {
  display: flex;
  width: 100rpx;
  height: 100rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #b8c6d2;
  border-radius: 50%;
  color: #476987;
  font-family: Georgia, serif;
  font-size: 22rpx;
}

.search-empty-title {
  margin-top: 24rpx;
  color: #34475a;
  font-size: 29rpx;
  font-weight: 600;
}

.search-empty-tip {
  margin-top: 10rpx;
  color: #9aa5af;
  font-size: 23rpx;
}

.editorial-footer {
  display: flex;
  margin: 52rpx 4rpx 0;
  align-items: center;
  color: #8997a4;
}

.footer-mark {
  color: #315777;
  font-family: Georgia, serif;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.footer-line {
  flex: 1;
  height: 1rpx;
  margin: 0 16rpx;
  background: #cbd5dc;
}

.footer-copy {
  font-size: 20rpx;
}

@keyframes masthead-reveal {
  from { opacity: 0; transform: translateY(-18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes cover-reveal {
  from { opacity: 0; transform: translateY(28rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes card-reveal {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
