page {
  min-height: 100%;
  background: #f5f5f5;
  color: #222222;
  font-family: sans-serif;
}

.news-list {
  background: #ffffff;
}

.list-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.list-item-image {
  flex-shrink: 0;
  width: 230rpx;
  height: 150rpx;
  margin-right: 24rpx;
  border-radius: 8rpx;
  background: #eeeeee;
}

.list-item-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: space-between;
}

.list-item-title {
  display: -webkit-box;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.list-item-date {
  color: #999999;
  font-size: 24rpx;
}

.empty-state {
  padding: 100rpx 30rpx;
  color: #999999;
  font-size: 28rpx;
  text-align: center;
}
