.page-shell { min-height: 100vh; box-sizing: border-box; padding: 72rpx 24rpx 36rpx; position: relative; background: #f5f1e8; color: #333333; }
.grid-backdrop { position: absolute; inset: 0; opacity: .36; background-image: radial-gradient(rgba(122,87,55,.14) 2rpx, transparent 2rpx); background-size: 34rpx 34rpx; }
.masthead, .level-grid, .bird-switcher { position: relative; z-index: 1; }
.home-button { position: absolute; left: 24rpx; z-index: 2; width: 132rpx; box-sizing: border-box; padding: 0 16rpx 0 10rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; background: linear-gradient(135deg, #ef554f, #d93432); color: #ffffff; box-shadow: 0 7rpx 14rpx rgba(174,45,43,.25); }
.home-button:active { transform: translateY(2rpx); box-shadow: 0 3rpx 8rpx rgba(174,45,43,.2); }
.home-arrow { width: 28rpx; height: 28rpx; line-height: 25rpx; border-radius: 50%; text-align: center; background: rgba(255,255,255,.2); font-size: 31rpx; font-weight: 400; }
.home-text { font-size: 21rpx; line-height: 1; font-weight: 700; letter-spacing: 1rpx; }
.bird-switcher { position: absolute; right: 24rpx; width: 420rpx; box-sizing: border-box; padding: 8rpx 10rpx 10rpx; border-radius: 22rpx; background: rgba(255,255,255,.96); border: 2rpx solid #ded4c8; box-shadow: 0 8rpx 18rpx rgba(87,55,34,.12); }
.switcher-label { display: block; margin: 0 0 5rpx 5rpx; color: #756456; font-size: 18rpx; line-height: 1.2; }
.bird-options { display: flex; align-items: center; justify-content: space-between; }
.bird-option { width: 92rpx; height: 66rpx; box-sizing: border-box; border: 2rpx solid transparent; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; gap: 3rpx; color: #756456; font-size: 17rpx; }
.bird-option image { width: 42rpx; height: 42rpx; }
.bird-option.active { border-color: #e64340; background: #fff3dc; color: #9c302e; font-weight: 700; }
.title-row { min-height: 62rpx; display: flex; align-items: center; }
.title { flex: 1; font-size: 48rpx; line-height: 1.1; font-weight: 700; color: #34261d; }
.subtitle { display: block; margin-top: 10rpx; font-size: 22rpx; line-height: 1.5; color: #756456; }
.level-grid { margin-top: 26rpx; display: flex; flex-wrap: wrap; justify-content: space-between; }
.level-card { width: 330rpx; flex: 0 0 330rpx; box-sizing: border-box; margin-bottom: 18rpx; padding: 10rpx 10rpx 14rpx; border-radius: 20rpx; background: #ffffff; border: 2rpx solid #ded4c8; box-shadow: 0 8rpx 18rpx rgba(87,55,34,.1); }
.level-card:active { transform: scale(.98); background: #fff8eb; }
.previewCanvas { display: block; width: 306rpx; height: 306rpx; margin: 0 auto; box-sizing: border-box; border-radius: 12rpx; border: 2rpx solid #c9beb1; background: #ffffff; }
.level-name { display: block; margin-top: 10rpx; text-align: center; font-size: 26rpx; line-height: 1.4; font-weight: 700; color: #34261d; }
