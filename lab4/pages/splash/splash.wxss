.splash { min-height: 100vh; position: relative; overflow: hidden; background: #3d78a8; color: #ffffff; }.scene, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }.scene { animation: sceneFloat 9s ease-in-out infinite alternate; }.shade { background: linear-gradient(180deg, rgba(8,30,52,.18), rgba(6,22,36,.72)); }.headline { position: absolute; top: 120rpx; left: 0; right: 0; display: flex; flex-direction: column; align-items: center; text-shadow: 0 4rpx 8rpx rgba(0,0,0,.35); }.headline text:first-child { font-size: 64rpx; font-weight: 700; }.headline text:last-child { margin-top: 12rpx; font-size: 20rpx; letter-spacing: 6rpx; }.selector { position: absolute; left: 32rpx; right: 32rpx; bottom: 176rpx; display: flex; justify-content: space-between; }.birdChoice { width: 146rpx; display: flex; flex-direction: column; align-items: center; color: rgba(255,255,255,.8); font-size: 22rpx; }.birdHalo { width: 106rpx; height: 106rpx; display: flex; align-items: center; justify-content: center; border: 5rpx solid rgba(255,255,255,.45); border-radius: 50%; box-shadow: 0 8rpx 18rpx rgba(0,0,0,.28); }.birdHalo image { width: 84rpx; height: 84rpx; }.birdChoice.active { color: #ffffff; font-weight: 700; transform: translateY(-14rpx); }.birdChoice.active .birdHalo { border-color: #ffffff; box-shadow: 0 0 0 6rpx rgba(255,255,255,.22), 0 8rpx 18rpx rgba(0,0,0,.28); }.enter { position: absolute; left: 54rpx; right: 54rpx; bottom: 58rpx; height: 94rpx; line-height: 94rpx; background: #f2bf2e; color: #4c2a12; border-radius: 47rpx; font-size: 31rpx; font-weight: 700; box-shadow: 0 8rpx 0 #b8731f; }.enter::after { border: 0; }@keyframes sceneFloat { from { transform: scale(1); } to { transform: scale(1.07); } }
