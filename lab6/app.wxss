page {
  min-height: 100%;
  background: #f6f7fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button::after { border: none; }

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx 150rpx;
  box-sizing: border-box;
}

.glass-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(28, 37, 54, 0.06);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 42rpx rgba(31, 41, 55, 0.08);
}

.bottom-nav {
  position: fixed;
  z-index: 20;
  left: 26rpx;
  right: 26rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  height: 104rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-radius: 34rpx;
  background: rgba(25, 33, 52, 0.95);
  box-shadow: 0 18rpx 40rpx rgba(23, 32, 52, 0.24);
  box-sizing: border-box;
}

.nav-item {
  min-width: 150rpx;
  color: #aab2c2;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.5;
}

.nav-item.active { color: #ffffff; font-weight: 650; }
.nav-icon { display: block; font-size: 34rpx; }

.primary-button {
  height: 92rpx;
  border-radius: 26rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 650;
  background: linear-gradient(135deg, #5b5cf0, #8a62ef);
  box-shadow: 0 14rpx 30rpx rgba(91, 92, 240, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.muted { color: #8a93a5; }
.section-title { font-size: 34rpx; font-weight: 700; }
