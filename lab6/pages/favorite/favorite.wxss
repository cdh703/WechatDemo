.heading { margin: 10rpx 4rpx 32rpx; }
.eyebrow { display: block; color: #6d70e8; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.page-title { display: block; margin: 6rpx 0 8rpx; font-size: 48rpx; font-weight: 800; }
.favorite-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.favorite-card { overflow: hidden; }
.favorite-card image { width: 100%; height: 300rpx; display: block; }
.favorite-copy { padding: 18rpx; }
.favorite-copy text { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 25rpx; font-weight: 650; }
.favorite-copy .muted { margin-top: 8rpx; font-size: 21rpx; font-weight: 400; }
.empty { margin-top: 70rpx; padding: 70rpx 36rpx; display: flex; flex-direction: column; align-items: center; gap: 14rpx; text-align: center; }
.empty-icon { color: #6668e9; font-size: 84rpx; }
.empty-title { font-size: 30rpx; font-weight: 700; }
.empty .primary-button { width: 330rpx; margin-top: 22rpx; }
.loading { padding: 120rpx 0; color: #8e96a7; text-align: center; }
