page { background: #111827; }
.detail-page { min-height: 100vh; background: #f6f7fb; }
.image-stage { position: relative; min-height: 560rpx; display: flex; align-items: center; background: #111827; }
.detail-image { width: 100%; max-height: 900rpx; }
.preview-tip { position: absolute; right: 24rpx; bottom: 24rpx; padding: 10rpx 18rpx; color: #fff; font-size: 21rpx; border-radius: 30rpx; background: rgba(0,0,0,.48); }
.detail-sheet { position: relative; z-index: 2; margin-top: -24rpx; padding: 38rpx 30rpx 70rpx; border-radius: 34rpx 34rpx 0 0; background: #f6f7fb; }
.category-row { display: flex; align-items: center; justify-content: space-between; }
.category { padding: 10rpx 20rpx; color: #5b5cf0; font-size: 22rpx; border-radius: 30rpx; background: #e7e7ff; }
.date { color: #969eae; font-size: 23rpx; }
.photo-title { margin-top: 24rpx; font-size: 42rpx; line-height: 1.35; font-weight: 780; }
.description { margin-top: 18rpx; color: #626d80; font-size: 27rpx; line-height: 1.7; }
.tag-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.tag { color: #6e76a8; font-size: 24rpx; }
.author-card { margin-top: 34rpx; padding: 22rpx 0; display: flex; align-items: center; border-top: 1rpx solid #e7eaf0; border-bottom: 1rpx solid #e7eaf0; }
.author-avatar { width: 84rpx; height: 84rpx; margin-right: 18rpx; border-radius: 50%; }
.author-copy { flex: 1; }
.author-name, .author-place { display: block; }
.author-name { font-size: 28rpx; font-weight: 700; }
.author-place { margin-top: 6rpx; color: #8c95a5; font-size: 22rpx; }
.chevron { color: #9aa1af; font-size: 54rpx; }
.action-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; margin-top: 28rpx; }
.action { padding: 18rpx 4rpx; display: flex; flex-direction: column; align-items: center; gap: 6rpx; color: #606a7d; font-size: 22rpx; border-radius: 22rpx; background: #fff; }
.action.selected { color: #5b5cf0; background: #eeeeff; }
.action-icon { font-size: 36rpx; line-height: 1; }
.note { margin-top: 30rpx; padding: 28rpx; }
.note-title { display: block; margin-bottom: 18rpx; font-size: 28rpx; font-weight: 700; }
.note-row { display: flex; justify-content: space-between; padding: 13rpx 0; color: #7d8697; font-size: 24rpx; }
.comments-block { margin-top: 38rpx; }
.comments-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18rpx; }
.comment-compose { padding: 12rpx 12rpx 12rpx 22rpx; display: flex; align-items: center; }
.comment-compose input { flex: 1; font-size: 25rpx; }
.comment-compose button { margin: 0; padding: 0 24rpx; color: #5b5cf0; font-size: 24rpx; background: transparent; }
.replying-tip { margin-bottom: 12rpx; padding: 0 8rpx; display: flex; justify-content: space-between; color: #737bed; font-size: 22rpx; }
.comment-thread { border-bottom: 1rpx solid #e7eaf0; }
.comment { display: flex; gap: 16rpx; padding: 26rpx 4rpx; }
.comment image { width: 68rpx; height: 68rpx; border-radius: 50%; }
.comment-main { flex: 1; }
.comment-name { font-size: 24rpx; font-weight: 700; }
.comment-time { margin-left: 14rpx; color: #a0a6b2; font-size: 20rpx; }
.comment-text { display: block; margin-top: 8rpx; color: #505a6c; font-size: 25rpx; line-height: 1.55; }
.comment-actions { margin-top: 14rpx; display: flex; justify-content: flex-end; gap: 48rpx; color: #8b93a2; font-size: 28rpx; }
.comment-actions text { padding: 10rpx 6rpx; }
.comment-like { font-weight: 600; }
.comment-like.selected { color: #e2536b; }
.comment-delete { color: #c26a73; }
.reply-list { margin-top: 18rpx; padding: 6rpx 16rpx; border-radius: 18rpx; background: #eef0f6; }
.reply { display: flex; gap: 12rpx; padding: 18rpx 0; }
.reply + .reply { border-top: 1rpx solid #dfe3eb; }
.reply image { width: 52rpx; height: 52rpx; border-radius: 50%; }
.reply-main { min-width: 0; flex: 1; }
.reply-to { color: #777fd8; font-size: 21rpx; }
.comment-empty { padding: 34rpx 0; color: #9aa2b1; font-size: 23rpx; text-align: center; }
.delete-button { margin-top: 28rpx; color: #dc5360; font-size: 25rpx; border-radius: 22rpx; background: #fff0f1; }
.loading-state { min-height: 100vh; display: flex; align-items: center; justify-content: center; color: #fff; }
