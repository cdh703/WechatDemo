.profile-hero { position: relative; overflow: hidden; padding: 70rpx 30rpx 100rpx; display: flex; flex-direction: column; align-items: center; color: #fff; background: linear-gradient(140deg,#252b45,#5b5cf0 60%,#a46bea); }
.hero-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.1); }
.orb-one { width: 360rpx; height: 360rpx; right: -130rpx; top: -100rpx; }
.orb-two { width: 230rpx; height: 230rpx; left: -90rpx; bottom: -80rpx; }
.profile-avatar { position: relative; width: 178rpx; height: 178rpx; border: 8rpx solid rgba(255,255,255,.85); border-radius: 50%; box-shadow: 0 18rpx 38rpx rgba(10,15,35,.24); }
.profile-name { position: relative; margin-top: 20rpx; font-size: 42rpx; font-weight: 800; }
.profile-location { position: relative; margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 23rpx; }
.profile-bio { position: relative; margin-top: 20rpx; font-size: 25rpx; }
.edit-button { position: relative; height: 62rpx; line-height: 62rpx; margin-top: 24rpx; padding: 0 34rpx; color: #fff; font-size: 23rpx; border: 1rpx solid rgba(255,255,255,.45); border-radius: 40rpx; background: rgba(255,255,255,.12); }
.profile-content { margin-top: -54rpx; position: relative; z-index: 3; }
.stats { padding: 30rpx 20rpx; display: flex; justify-content: space-around; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat + .stat { border-left: 1rpx solid #eceef3; }
.stat-number { font-size: 38rpx; font-weight: 800; }
.stat-label { margin-top: 5rpx; color: #8e96a8; font-size: 22rpx; }
.works-head { display: flex; justify-content: space-between; align-items: baseline; margin: 42rpx 2rpx 20rpx; }
.works-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.work-item { position: relative; height: 235rpx; overflow: hidden; border-radius: 18rpx; background: #e5e8ef; }
.work-item image { width: 100%; height: 100%; }
.work-overlay { position: absolute; left: 0; right: 0; bottom: 0; padding: 30rpx 12rpx 10rpx; display: flex; justify-content: space-between; color: #fff; font-size: 19rpx; background: linear-gradient(transparent,rgba(0,0,0,.62)); }
.empty-work { padding: 60rpx 30rpx; color: #8a93a5; text-align: center; font-size: 25rpx; }
.modal-mask { position: fixed; z-index: 50; inset: 0; display: flex; align-items: flex-end; background: rgba(15,23,42,.48); }
.edit-sheet { width: 100%; padding: 34rpx 34rpx calc(44rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 36rpx 36rpx 0 0; background: #fff; }
.edit-head { display: flex; align-items: center; justify-content: space-between; }
.close { padding: 0 10rpx; color: #8c94a5; font-size: 52rpx; }
.avatar-picker { width: 180rpx; margin: 26rpx auto; padding: 0; color: #6c74e8; font-size: 22rpx; background: transparent; }
.avatar-picker image { display: block; width: 126rpx; height: 126rpx; margin: 0 auto 10rpx; border-radius: 50%; }
.edit-field { margin-bottom: 20rpx; padding: 18rpx 22rpx; border-radius: 20rpx; background: #f3f4f8; }
.edit-field text { display: block; margin-bottom: 8rpx; color: #8a92a2; font-size: 21rpx; }
.edit-field input { font-size: 27rpx; }
