.home-page { padding-top: 34rpx; }
.topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.eyebrow { display: block; color: #6d70e8; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.brand { margin-top: 4rpx; font-size: 48rpx; font-weight: 800; letter-spacing: -2rpx; }
.signed-user { display: block; margin-top: 6rpx; color: #8b93a5; font-size: 22rpx; }
.topbar-right { display: flex; align-items: center; gap: 14rpx; }
.music-box { display: flex; align-items: center; gap: 12rpx; height: 76rpx; padding: 0 18rpx; border-radius: 40rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(32,41,60,.12), 0 0 0 2rpx #e4e6f5; box-sizing: border-box; }
.music-disc { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; border-radius: 50%; color: #fff; font-size: 26rpx; background: linear-gradient(135deg,#5b5cf0,#9b63ed); }
.music-disc.spinning { animation: disc-spin 3s linear infinite; }
@keyframes disc-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
.music-name { max-width: 150rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #343e52; font-size: 24rpx; }
.music-next, .music-list-btn { padding: 0 6rpx; color: #8a93a5; font-size: 32rpx; }
.music-panel { margin: -8rpx 0 20rpx; padding: 10rpx 20rpx; }
.music-item { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 6rpx; font-size: 26rpx; }
.music-item + .music-item { border-top: 1rpx solid #edf0f5; }
.music-item.active .music-item-name { color: #5b5cf0; font-weight: 650; }
.avatar-button { flex-shrink: 0; width: 76rpx; height: 76rpx; padding: 4rpx; border-radius: 50%; background: #fff; box-shadow: 0 8rpx 22rpx rgba(32, 41, 60, .12), 0 0 0 2rpx #e4e6f5; box-sizing: border-box; }
.avatar-button-hover { opacity: .75; }
.top-avatar { display: block; width: 100%; height: 100%; border-radius: 50%; }
.notice-bar { height: 60rpx; line-height: 60rpx; overflow: hidden; margin-bottom: 22rpx; border-radius: 20rpx; background: linear-gradient(90deg, rgba(91,92,240,.1), rgba(155,99,237,.14)); }
.notice-track { display: inline-block; white-space: nowrap; padding-left: 100%; color: #5b5cf0; font-size: 24rpx; animation: marquee 18s linear infinite; }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-100%); } }
.hero { position: relative; height: 480rpx; overflow: hidden; margin-bottom: 26rpx; }
.hero-image { width: 100%; height: 100%; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(9,16,29,.02) 35%, rgba(9,16,29,.82) 100%); }
.hero-copy { position: absolute; left: 34rpx; right: 34rpx; bottom: 32rpx; color: #fff; }
.hero-label { display: inline-block; padding: 9rpx 16rpx; border-radius: 30rpx; background: rgba(255,255,255,.18); font-size: 22rpx; }
.hero-title { display: block; margin-top: 18rpx; font-size: 38rpx; line-height: 1.3; font-weight: 750; }
.hero-meta { display: block; margin-top: 12rpx; color: rgba(255,255,255,.82); font-size: 23rpx; }
.search-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.search-box { flex: 4; min-width: 0; height: 84rpx; padding: 0 26rpx; display: flex; align-items: center; gap: 14rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(31,41,55,.06); }
.search-box input { flex: 1; height: 84rpx; color: #2f3646; font-size: 28rpx; }
.search-placeholder { color: #9aa2b1; font-size: 28rpx; }
.search-icon { color: #8a93a6; font-size: 32rpx; }
.upload-shortcut { flex: 1; min-width: 0; height: 84rpx; line-height: 84rpx; padding: 0; color: #fff; font-size: 38rpx; border-radius: 24rpx; background: #5b5cf0; }
.upload-shortcut::after { border: none; }
.category-scroll { width: 100%; white-space: nowrap; margin-bottom: 26rpx; }
.category-list { display: flex; gap: 14rpx; padding: 4rpx 2rpx; }
.category-pill { padding: 16rpx 29rpx; border-radius: 40rpx; color: #778096; background: #e9ebf2; font-size: 25rpx; }
.category-pill.active { color: #fff; background: #1e293b; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 12rpx 2rpx 20rpx; }
.section-actions { display: flex; align-items: center; gap: 18rpx; }
.category-link { color: #6266e8; font-size: 22rpx; }
.result-count { color: #929aac; font-size: 23rpx; }
.photo-grid, .skeleton-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.photo-card { overflow: hidden; }
.card-image { width: 100%; height: 300rpx; display: block; background: #e8ebf2; }
.card-content { padding: 20rpx 19rpx 22rpx; }
.card-title { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; min-height: 68rpx; font-size: 27rpx; line-height: 1.35; font-weight: 650; }
.author-row { display: flex; align-items: center; margin-top: 16rpx; color: #7d8698; font-size: 21rpx; }
.author-info { min-width: 0; flex: 1; display: flex; align-items: center; }
.mini-avatar { width: 36rpx; height: 36rpx; margin-right: 9rpx; border-radius: 50%; }
.author-name { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.like-count, .comment-count, .view-count { margin-left: 10rpx; }
.sort-switch { display: flex; padding: 4rpx; border-radius: 30rpx; background: #e9ebf2; }
.sort-option { padding: 8rpx 20rpx; border-radius: 26rpx; color: #778096; font-size: 22rpx; }
.sort-option.active { color: #fff; background: #1e293b; }
.skeleton { height: 410rpx; border-radius: 28rpx; background: linear-gradient(90deg,#eceef3 20%,#f7f8fa 40%,#eceef3 60%); background-size: 300% 100%; animation: shimmer 1.5s infinite; }
@keyframes shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
.empty { padding: 80rpx 30rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.empty-icon { font-size: 74rpx; color: #8187ef; }
.empty-title { font-size: 29rpx; font-weight: 650; }
.load-more { padding: 34rpx 0 8rpx; color: #9aa2b1; font-size: 22rpx; text-align: center; }
