page { background: #101525; color: #fff; }
.category-page { min-height: 100vh; padding: 42rpx 26rpx 150rpx; box-sizing: border-box; }
.category-head { margin-bottom: 30rpx; }.eyebrow { display: block; color: #a9adff; font-size: 20rpx; letter-spacing: 4rpx; font-weight: 700; }.page-title { display: block; margin-top: 12rpx; font-size: 48rpx; font-weight: 800; }.muted { display: block; margin-top: 10rpx; color: #a8afc2; font-size: 23rpx; }
.photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6rpx; }.photo-item { position: relative; height: 226rpx; overflow: hidden; background: #252d40; }.photo-item image { width: 100%; height: 100%; display: block; }.photo-label { position: absolute; left: 0; right: 0; bottom: 0; padding: 28rpx 10rpx 9rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; background: linear-gradient(transparent, rgba(8,12,22,.85)); color: #fff; font-size: 19rpx; }
.empty, .loading { padding: 180rpx 20rpx; color: #a8afc2; text-align: center; font-size: 27rpx; }.upload-button { position: fixed; left: 26rpx; right: 26rpx; bottom: 32rpx; height: 92rpx; line-height: 92rpx; border-radius: 26rpx; color: #fff; background: #6669f4; font-size: 29rpx; }.upload-button::after { border: none; }
