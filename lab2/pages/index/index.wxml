<!--index.wxml-->
<navigation-bar title="{{navTitle}}" back="{{false}}" color="#ffffff" background="{{navBg}}"></navigation-bar>

<!-- 滚动进度条 -->
<view class="progress-track">
  <view class="progress-bar" style="{{progressStyle}}"></view>
</view>

<scroll-view class="scrollarea" scroll-y type="list" bindscroll="onScroll" show-scrollbar="{{false}}">
  <view class="page">

    <!-- 背景氛围光 -->
    <view class="aurora aurora-a"></view>
    <view class="aurora aurora-b"></view>
    <view class="aurora aurora-c"></view>

    <!-- 顶部 Banner + Hero（profile-header 内部含 #card-0 / #card-1） -->
    <profile-header
      banner="{{banner}}"
      name="{{name}}"
      major="{{major}}"
      degree="{{degree}}"
      intro="{{intro}}"
      status="{{status}}"
      bannerShown="{{animateList[0]}}"
      heroShown="{{animateList[1]}}"
      bind:bannertap="onBannerTap"
    ></profile-header>

    <!-- 01 关于我 -->
    <card-section title="关于我" no="01" rd="2" show="{{animateList[2]}}" cid="card-2">
      <view class="info-row">
        <text class="info-label">姓名</text>
        <text class="info-value">{{about.name}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">专业</text>
        <text class="info-value">{{about.major}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">方向</text>
        <view class="info-tags">
          <text wx:for="{{about.directions}}" wx:key="*this" class="info-tag">{{item}}</text>
        </view>
      </view>
    </card-section>

    <!-- 02 技能 -->
    <card-section title="技能" no="02" rd="3" show="{{animateList[3]}}" cid="card-3">
      <skill-panel skills="{{skills}}" animateIn="{{animateList[3]}}"></skill-panel>
    </card-section>

    <!-- 03 项目经历 -->
    <card-section title="项目经历" no="03" rd="4" show="{{animateList[4]}}" cid="card-4">
      <timeline-panel timeline="{{timeline}}"></timeline-panel>
    </card-section>

    <!-- 04 兴趣 -->
    <card-section title="兴趣" no="04" rd="5" show="{{animateList[5]}}" cid="card-5">
      <view class="cloud">
        <text wx:for="{{interests}}" wx:key="name" class="cloud-tag {{item.cls}}">{{item.name}}</text>
      </view>
    </card-section>

    <!-- 联系卡片（contact-card 内部含 #card-6） -->
    <contact-card
      contact="{{contact}}"
      rd="6"
      show="{{animateList[6]}}"
      cid="card-6"
      bind:contacttap="onContactTap"
    ></contact-card>

    <!-- 底部 -->
    <view class="footer">
      <view class="footer-line"></view>
      <button class="share-btn" open-type="share">分享名片</button>
      <text class="footer-text">{{footerBrand}}</text>
    </view>

  </view>
</scroll-view>
