/**index.wxss — 页面级骨架样式
 *  本文件仅包含：scroll-view 容器、进度条、aurora 背景光、page 内边距、底部 footer。
 *  所有业务组件样式（.card / .banner / .hero / .skill / .timeline / .cloud / .contact 等）
 *  已提升至 app.wxss，通过 styleIsolation: apply-shared 在组件内共享。
 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* ===== 顶部滚动进度条 ===== */
.progress-track {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 9999;
  height: 2rpx;
  background: rgba(79, 172, 254, 0.15);
}
.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #4facfe, #6e5cff);
  box-shadow: 0 0 12rpx rgba(79, 172, 254, 0.6);
  transition: width 0.1s linear;
}

.page {
  position: relative;
  z-index: 1;
  padding: 24rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 背景氛围光（极光）===== */
.aurora {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.aurora-a {
  top: 300rpx; left: -220rpx;
  width: 560rpx; height: 560rpx;
  background: radial-gradient(circle, rgba(79, 172, 254, 0.30), transparent 65%);
}
.aurora-b {
  top: 1150rpx; right: -240rpx;
  width: 600rpx; height: 600rpx;
  background: radial-gradient(circle, rgba(110, 92, 255, 0.26), transparent 65%);
}
.aurora-c {
  top: 2200rpx; left: -200rpx;
  width: 520rpx; height: 520rpx;
  background: radial-gradient(circle, rgba(56, 239, 125, 0.14), transparent 65%);
}

/* ===== 底部 Footer ===== */
.footer {
  text-align: center;
  padding: 10rpx 0 calc(20rpx + env(safe-area-inset-bottom));
}
.footer-line {
  width: 80rpx; height: 2rpx; margin: 0 auto 18rpx;
  background: linear-gradient(90deg, transparent, rgba(79, 172, 254, 0.7), transparent);
}
.footer-text {
  font-size: 22rpx;
  color: rgba(232, 238, 245, 0.4);
  letter-spacing: 4rpx;
}

/* 分享按钮 */
.share-btn {
  display: inline-block;
  margin: 0 0 14rpx;
  padding: 8rpx 28rpx;
  font-size: 24rpx;
  color: rgba(79, 172, 254, 0.9);
  background: rgba(79, 172, 254, 0.08);
  border: 1rpx solid rgba(79, 172, 254, 0.3);
  border-radius: 999rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
}
.share-btn::after { border: none; }
